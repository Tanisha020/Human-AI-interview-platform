# PostgreSQL database used by Next.js, Prisma, and the Socket.IO server
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/human_ai_interview?schema=public"

# Use a long random secret. The Next.js app and Socket.IO server must use the same value.
AUTH_SECRET="replace-with-a-long-random-secret"
SOCKET_AUTH_SECRET="replace-with-the-same-long-random-secret"

# Local AI interviewer
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"
AI_PROVIDER="ollama"

# Browser/server addresses; change these for deployment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
